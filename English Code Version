# Estimate daily volatility and annualize it using 252 trading days.
sigma_daily = returns.std()
sigma = float(sigma_daily * np.sqrt(252))


# ============================================================
# 5. BLACK-SCHOLES CALL PRICING
# ============================================================

# Price European call options using the Black-Scholes model.
# A constant risk-free rate of 5% is assumed for simplicity.
# This assumption does not reflect the actual market yield curve.
# Dividends are ignored in this initial implementation.

r = 0.05

# Time to expiration, expressed in years.
Tprice = (pd.Timestamp(T1) - today).days / 365

if Tprice <= 0:
    raise ValueError("The selected option maturity must be in the future.")


def Blackscholes(S, K, r, Tprice, sigma):
    """
    Calculate the theoretical price of a European call option.

    Parameters
    ----------
    S : float
        Current underlying price.
    K : float
        Strike price.
    r : float
        Continuously compounded risk-free rate.
    Tprice : float
        Time to expiration in years.
    sigma : float
        Annualized volatility.

    Returns
    -------
    float
        Theoretical call option price.
    """
    if Tprice <= 0:
        return max(S - K, 0)

    if sigma <= 0:
        return max(S - K * np.exp(-r * Tprice), 0)

    d1 = (
        np.log(S / K) + (r + 0.5 * sigma**2) * Tprice
    ) / (sigma * np.sqrt(Tprice))

    d2 = d1 - sigma * np.sqrt(Tprice)

    C = S * norm.cdf(d1) - K * np.exp(-r * Tprice) * norm.cdf(d2)

    return C


# For European options without dividends, put-call parity gives:
# Put = Call - S + K * exp(-r * T)


# ============================================================
# 6. THEORETICAL PRICES VS. MARKET PRICES
# ============================================================

# Compare Black-Scholes theoretical prices with observed call prices.
