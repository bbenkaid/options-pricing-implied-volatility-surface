# Estimate a variance swap strike using OTM option prices.
# The implementation approximates an integral with a Riemann sum.
# A standard market implementation requires careful strike spacing,
# forward estimation, K0 treatment, and market conventions.

def pricing_varswap(Calls, Puts, T, r, S):
    if T <= 0:
        raise ValueError("Time to maturity must be positive.")

    # Estimate the forward price under the constant-rate,
    # zero-dividend assumption.
    F = S * np.exp(r * T)

    # Select OTM calls above the forward and OTM puts below it.
    Callsotm = Calls[Calls["strike"] > F].copy()
    Putsotm = Puts[Puts["strike"] < F].copy()

    # Combine and sort the selected options by strike.
    data = pd.concat([Callsotm, Putsotm], axis=0)
    data = data.sort_values("strike").reset_index(drop=True)

    # Remove invalid or non-positive midpoint prices.
    data = data[
        np.isfinite(data["mid"])
        & (data["mid"] > 0)
        & np.isfinite(data["strike"])
    ].reset_index(drop=True)

    if len(data) < 2:
        raise ValueError("Not enough OTM option quotes for variance swap pricing.")

    # Approximate the integral using adjacent strike intervals.
    Pricing = 0.0

    for i in range(len(data) - 1):
        K_i = float(data.loc[i, "strike"])
        K_next = float(data.loc[i + 1, "strike"])
        delta = K_next - K_i
        O = float(data.loc[i, "mid"])

        if K_i > 0 and delta > 0:
            Pricing += (O / K_i**2) * delta

    # Approximate annualized variance and volatility strikes.
    # This is an initial approximation, not a fully validated
    # market-standard variance swap replication.
    Kvar = (2 / T) * np.exp(r * T) * Pricing

    if Kvar < 0:
        return [Kvar, np.nan]

    sigmavar = np.sqrt(Kvar) * 100

    return [Kvar, sigmavar]


