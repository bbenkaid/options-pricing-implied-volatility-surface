    ok = (
        np.isfinite(v)
        & (v > 0.05)
        & (v < 1.5)
        & (np.abs(k) < 0.25)
    )

    Xi.append(k[ok])
    Yi.append(np.full(ok.sum(), Tprice))
    Zi.append(v[ok])

# Combine observations from all maturities into single arrays.
X = np.concatenate(Xi)
