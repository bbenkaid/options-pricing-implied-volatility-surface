# ============================================================
# 7. IMPLIED VOLATILITY INVERSION
# ============================================================

# Infer implied volatility by inverting the Black-Scholes formula.
# For a given market price, find the volatility that reproduces it.
# Two numerical approaches are considered.


# ------------------------------------------------------------
# 7.1. Grid-search approximation
# ------------------------------------------------------------

def inversebs(C, S, K, r, Tprice, sigma):
    # Search over a range of candidate volatility values.
    implicite = np.linspace(max(sigma / 10, 0.001), 5 * sigma, 200)

    errors = [
        abs(Blackscholes(S, K, r, Tprice, vol) - C)
        for vol in implicite
    ]

    # Return the volatility producing the smallest pricing error.
    i = np.argmin(errors)

    return implicite[i]


# ------------------------------------------------------------
# 7.2. Brent's root-finding method
# ------------------------------------------------------------

def inversebs2(C, S, K, r, Tprice):
    # Define the pricing error as a function of volatility.
    def f(vol):
        return Blackscholes(S, K, r, Tprice, vol) - C

    # Check whether the market price is compatible with
    # the Black-Scholes price bounds for a European call.
    lower_bound = max(S - K * np.exp(-r * Tprice), 0)
    upper_bound = S

    if not (lower_bound <= C <= upper_bound):
        return np.nan

    # Find a root within the volatility interval.
    # Return NaN if the interval does not bracket a root.
    try:
        return brentq(f, 1e-4, 5.0)
    except ValueError:
        return np.nan


