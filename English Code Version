from scipy.optimize import brentq


def inversebs2(C, S, K, r, Tprice):
    # Define the pricing error as a function of volatility.
    def f(sigma):
        return C - Blackscholes(S, K, r, Tprice, sigma)

    # Find a root within the specified volatility interval.
    # Return NaN if no root can be bracketed in this interval.
    try:
        return brentq(f, 0.0001, 5)
    except ValueError:
