# Estimate the variance swap strike using option prices.
# The approach approximates an integral over out-of-the-money
# (OTM) options with a weighted Riemann sum.
# Each option price is weighted by 1 / K^2 and the strike spacing.

def pricing_varswap(Calls, Puts, T, r, S):
    # Estimate the forward price using the assumed risk-free rate.
    F = S * np.exp(r * T)

    # Select OTM calls above the forward and OTM puts below it.
    Callsotm = Calls[Calls["strike"] > F]
    Putsotm = Puts[Puts["strike"] < F]

    # Combine and sort the selected OTM options by strike.
    data = pd.concat([Callsotm, Putsotm], axis=0)
    data = data.sort_values(by="strike", ascending=True)
    data = data.reset_index()

    # Approximate the integral using adjacent strike intervals.
    Pricing = 0
    for i in range(len(data["strike"]) - 1):
        K_i = data.loc[i, "strike"]
        K_iplus = data.loc[i + 1, "strike"]
        delta = K_iplus - K_i
        O = data.loc[i, "mid"]

        Pricing += (O / (K_i**2)) * delta

    # Convert the option-price integral approximation
    # into an annualized variance strike and volatility strike.
    # The current implementation is an approximation.
    # Additional terms and conventions may be required
    # for a standard market variance swap calculation.
    Kvar = (2 / T) * np.exp(r * T) * Pricing
    sigmavar = np.sqrt(Kvar) * 100

    return [Kvar, sigmavar]


