def Blackscholes(S, K, r, Tprice, sigma):
    # Calculate the theoretical price of a European call.
    # The corresponding European put price can be obtained
    # using put-call parity.
    d1 = (
        np.log(S / K) + (r + 0.5 * sigma**2) * Tprice
    ) / (sigma * np.sqrt(Tprice))

    d2 = d1 - sigma * np.sqrt(Tprice)

    C = S * norm.cdf(d1) - K * np.exp(-r * Tprice) * norm.cdf(d2)
    return C


