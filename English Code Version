# 9. VOLATILITY SURFACE DATA COLLECTION
# ============================================================

# Extend the volatility smile analysis across all available
# expiration dates to construct an initial implied volatility surface.
# The same approach can be adapted to other underlyings.

SP500 = yf.Ticker("^SPX")
QQQ = yf.Ticker("QQQ")
GLD = yf.Ticker("GLD")
NVDA = yf.Ticker("NVDA")

# Retrieve all available SPX option expiration dates.
T = list(SP500.options)

# Collect strike prices and implied volatilities for each maturity.
K = []
V = []

for t in T:
    Options = SP500.option_chain(t)

    # Use calls with positive bids as a basic quote filter.
    Calls_surface = Options.calls.copy()
    Calls_surface = Calls_surface[Calls_surface["bid"] > 0]

    K.append(list(Calls_surface["strike"]))
    V.append(list(Calls_surface["impliedVolatility"]))


# ============================================================
# 10. DATA PREPARATION FOR SURFACE INTERPOLATION
# ============================================================

# Prepare log-forward moneyness, time to maturity,
# and implied volatility observations.

Xi, Yi, Zi = [], [], []

for i in range(len(T)):
    T1 = T[i]

    # Convert time to expiration into years.
    Tprice = (pd.Timestamp(T1) - today).days / 365

    # Skip expired options.
    if Tprice <= 0:
        continue

    # Estimate the forward price under the constant-rate assumption.
    F = S * np.exp(r * Tprice)

    strikes = np.asarray(K[i], dtype=float)
    vols = np.asarray(V[i], dtype=float)

    # Calculate log-forward moneyness: ln(K / F).
    k = np.log(strikes / F)

    # Filter invalid or extreme implied volatilities
    # and observations far from the forward price.
    ok = (
        np.isfinite(vols)
        & np.isfinite(k)
        & (vols > 0.05)
        & (vols < 1.5)
        & (strikes > 0)
        & (np.abs(k) < 0.25)
    )

    if np.any(ok):
        Xi.append(k[ok])
        Yi.append(np.full(np.sum(ok), Tprice))
        Zi.append(vols[ok])

if not Xi:
    raise ValueError("No valid implied volatility observations for the surface.")

# Combine observations from all maturities.
X = np.concatenate(Xi)
Y = np.concatenate(Yi)
Z = np.concatenate(Zi)


# ============================================================
# 11. TOTAL VARIANCE INTERPOLATION
# ============================================================

# Define a common grid for log-forward moneyness and maturity.
k_grid = np.linspace(-0.2, 0.2, 80)
t_grid = np.linspace(Y.min(), Y.max(), 60)
Xg, Yg = np.meshgrid(k_grid, t_grid)

# Interpolate total variance, defined as sigma^2 * T.
# Total variance is used as the interpolation variable.
W = griddata(
    (X, Y),
    Z**2 * Y,
    (Xg, Yg),
    method="linear",
    rescale=True
)

# Convert interpolated total variance back into implied volatility.
Zg = np.sqrt(np.where((Yg > 0) & (W >= 0), W / Yg, np.nan))


# ============================================================
# 12. THREE-DIMENSIONAL VOLATILITY SURFACE
# ============================================================

# Plot the interpolated implied volatility surface.
fig = plt.figure(figsize=(12, 7))
ax = fig.add_subplot(111, projection="3d")

ax.invert_yaxis()
ax.plot_surface(Xg, Yg, Zg, cmap="plasma")

ax.set_xlabel("Log-Forward Moneyness ln(K/F)")
ax.set_ylabel("Time to Maturity (Years)")
ax.set_zlabel("Implied Volatility")
ax.set_title("S&P 500 Implied Volatility Surface")

plt.tight_layout()
plt.show()
