def Blackscholes(S,K,r,Tprice,sigma):
    # Price the call; put-call parity can be used to obtain the put price
    d1 = (np.log(S/K) + (r+0.5*sigma**2)*Tprice)/(sigma*np.sqrt(Tprice))
    d2 = d1-sigma*np.sqrt(Tprice)
    C = S*norm.cdf(d1)-K*np.exp(-r*Tprice)*norm.cdf(d2)
    return C

# For a put, put = Black-Scholes(S, K, r, T, sigma) - S + K * exp(-r*T)

# N_z = norm.cdf(z), the cumulative distribution function of the standard normal distribution
