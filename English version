# Variance swap pricing

# To calculate the variance swap strike, sum OTM option prices weighted by 1/K^2 across strikes
# Here, a Riemann sum is used to approximate the integral of f(K) dK as the sum of f(K) times the strike interval

def pricing_varswap(Calls,Puts,T,r,S):
    # Calculate the variance strike and the volatility strike
    
    
    # Forward price
    F = S*np.exp(r*T)
    
    Callsotm = Calls[Calls["strike"]>F]
    Putsotm = Puts[Puts["strike"]<F]

    data = pd.concat([Callsotm,Putsotm],axis = 0)
    data = data.sort_values(by = "strike", ascending = True)
    data = data.reset_index()

    Pricing = 0
    for i in range(len(data["strike"])-1):
        K_i = data.loc[i,"strike"]
        K_iplus =  data.loc[i+1,"strike"]
        delta = K_iplus-K_i
        O = data.loc[i,"mid"]
        Pricing += (O/(K_i**2))*delta
    #Pricing += O/(K_i**2)
    Kvar = (2/T)*np.exp(r*T)*Pricing
    sigmavar = np.sqrt(Kvar)*100
    return [Kvar,sigmavar]

    
