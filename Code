#2Methodes

def inversebs(C,S,K,r,Tprice,sigma):
    implicite = np.linspace(sigma/10,stop = 15*sigma, num=200)
    L = []
    for sigma in implicite:
        L.append(np.absolute(Blackscholes(S, K, r, Tprice, sigma)-C))
    i = np.argmin(L)
    return implicite[i]

from scipy.optimize import brentq


def inversebs2(C,S,K,r,Tprice):
    def f(sigma):
        return(C-Blackscholes(S, K, r, Tprice, sigma))
    try:
        return brentq(f,0.0001,5)
    except ValueError:
        return np.nan
    

