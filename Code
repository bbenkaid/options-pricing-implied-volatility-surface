def Blackscholes(S,K,r,Tprice,sigma):
    #Price le call, par parité call put on peut obtenir le pricing du put
    d1 = (np.log(S/K) + (r+0.5*sigma**2)*Tprice)/(sigma*np.sqrt(Tprice))
    d2 = d1-sigma*np.sqrt(Tprice)
    C = S*norm.cdf(d1)-K*np.exp(-r*Tprice)*norm.cdf(d2)
    return C

#Pour un Put on a donc put = BlackScholes(S, K, r, T, sigma) - S + K*np.exp(-r*T)

#N_z = norm.cdf(z) la fonction de répartition de la loi normale standard (N(z)
